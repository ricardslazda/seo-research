{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
    "version": "0.2",
    "language": "en-US",
    "ignorePaths": ["node_modules/**", "pnpm-lock.yaml", "sites/**", "**/fixtures/**"],
    "ignoreRegExpList": ["/```[\\s\\S]*?```/g", "/`[^`\\n]+`/g"],
    "words": [
        "backlink",
        "backlinks",
        "dataforseo",
        "drizzle",
        "hreflang",
        "pnpm",
        "serp",
        "serps",
        "sqlite",
        "tsx",
        "vitest",
        "zod"
    ]
}
